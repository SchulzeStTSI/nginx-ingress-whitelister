{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "LoadKeys",
            "type": "debugpy",
            "request": "launch",
            "program": "loadKeys.py",
            "console": "integratedTerminal",
            "env": {
                "CONFIG_REPO": "",
                "CONFIG_TAG": "main",
                "X509_CAFILEPATTERN":"CA*.pem",
                "X509_CERTFILEPATTERN":"TLS*.pem",
                "X509_SOURCEFOLDER": "TLS",
                "X509_REPO": "https://github.com/WorldHealthOrganization/tng-participants-dev",
                "CONFIG_CONFIGLOADER": "internal.configLoader.didConfigMapLoader.didConfigMapLoader,internal.configLoader.gitRepoEnvMapLoader.gitRepoEnvMapLoader",
                "CONFIG_PUBKEYLOADER": "internal.pubKeyLoader.didLoader.didLoader,internal.pubKeyLoader.x509Loader.x509Loader",
                "CERTIFICATES_CERTPINNING": "true"

            }
        }
    ]
}